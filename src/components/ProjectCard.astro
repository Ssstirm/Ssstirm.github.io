---
import { type Locale, localePath } from '../i18n';

interface Props {
  locale: Locale;
  slug: string;
  title: string;
  subtitle?: string;
  period?: string;
  org?: string;
  role?: string;
  summary: string;
  stack: string[];
  viewLabel: string;
}

const { locale, slug, title, subtitle, period, org, role, summary, stack, viewLabel } = Astro.props;
const href = localePath(locale, `/projects/${slug}`);
---

<a
  href={href}
  class="group block py-6 border-t border-ink/10 no-underline hover:no-underline"
>
  <div class="flex items-baseline justify-between gap-6 mb-1">
    <h3 class="text-lg font-semibold text-ink group-hover:text-accent transition-colors">
      {title}
    </h3>
    {period && <span class="text-xs text-ink-muted whitespace-nowrap font-mono">{period}</span>}
  </div>
  {subtitle && <p class="text-sm text-ink-soft mb-2">{subtitle}</p>}
  {(org || role) && (
    <p class="text-xs text-ink-muted mb-3">
      {[role, org].filter(Boolean).join(' · ')}
    </p>
  )}
  <p class="text-[15px] leading-relaxed text-ink/80 mb-3">
    {summary}
  </p>
  {stack.length > 0 && (
    <div class="flex flex-wrap gap-x-3 gap-y-1 text-xs text-ink-muted font-mono">
      {stack.map((s) => <span>{s}</span>)}
    </div>
  )}
  <div class="mt-3 text-xs text-accent opacity-0 group-hover:opacity-100 transition-opacity">
    {viewLabel} →
  </div>
</a>
