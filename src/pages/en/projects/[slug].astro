---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import ProjectDetail from '../../../components/ProjectDetail.astro';
import { t } from '../../../i18n';

export async function getStaticPaths() {
  const all = await getCollection('projects', ({ data }) => data.locale === 'en');
  return all.map((p) => ({
    params: { slug: p.data.key },
    props: { entry: p },
  }));
}

const { entry } = Astro.props;
const tr = t('en');
---

<Base
  locale="en"
  title={`${entry.data.title} — ${tr.hero.name}`}
  description={entry.data.summary}
  pathOnOtherLocale={`/projects/${entry.data.key}`}
>
  <ProjectDetail entry={entry} locale="en" />
</Base>
