---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { t, localePath } from '../../i18n';

export async function getStaticPaths() {
  const all = await getCollection('projects', ({ data }) => data.locale === 'en');
  return all.map((p) => ({
    params: { slug: p.data.key },
    props: { entry: p },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const tr = t('en');
---

<Base
  locale="en"
  title={`${entry.data.title} — ${tr.hero.name}`}
  description={entry.data.summary}
  pathOnOtherLocale={`/projects/${entry.data.key}`}
>
  <article class="container-prose py-12 md:py-16">
    <a
      href={localePath('en', '/')}
      class="text-xs text-ink-muted no-underline hover:text-ink hover:no-underline"
    >
      ← {tr.ui.back_home}
    </a>

    <header class="mt-6 mb-8">
      <p class="text-xs uppercase tracking-[0.2em] text-ink-muted mb-2 font-mono">
        {entry.data.category === 'agent' ? 'AI Agent' : entry.data.category === 'xr' ? 'XR / Gaming' : 'Generative Models'}
      </p>
      <h1 class="text-3xl md:text-4xl font-bold tracking-tight mb-3">
        {entry.data.title}
      </h1>
      {entry.data.subtitle && <p class="text-lg text-ink-soft">{entry.data.subtitle}</p>}

      <dl class="mt-6 grid grid-cols-[auto_1fr] gap-x-6 gap-y-1 text-sm">
        {entry.data.period && (
          <>
            <dt class="text-ink-muted font-mono text-xs">Period</dt>
            <dd class="text-ink/85">{entry.data.period}</dd>
          </>
        )}
        {entry.data.role && (
          <>
            <dt class="text-ink-muted font-mono text-xs">Role</dt>
            <dd class="text-ink/85">{entry.data.role}</dd>
          </>
        )}
        {entry.data.org && (
          <>
            <dt class="text-ink-muted font-mono text-xs">Org</dt>
            <dd class="text-ink/85">{entry.data.org}</dd>
          </>
        )}
        {entry.data.stack.length > 0 && (
          <>
            <dt class="text-ink-muted font-mono text-xs">Stack</dt>
            <dd class="text-ink/85">{entry.data.stack.join(' · ')}</dd>
          </>
        )}
        {entry.data.links.length > 0 && (
          <>
            <dt class="text-ink-muted font-mono text-xs">Links</dt>
            <dd class="text-ink/85">
              {entry.data.links.map((l, i) => (
                <>
                  {i > 0 && ' · '}
                  <a href={l.href} target="_blank" rel="noopener">{l.label}</a>
                </>
              ))}
            </dd>
          </>
        )}
      </dl>
    </header>

    <div class="prose prose-neutral max-w-none prose-headings:font-semibold prose-headings:tracking-tight prose-h2:text-xl prose-h2:mt-10 prose-h2:mb-3 prose-p:leading-relaxed prose-a:text-accent">
      <Content />
    </div>
  </article>
</Base>
